APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
AUTH_SECRET=replace-with-at-least-32-random-characters
POSTGRES_DB=cybermind
POSTGRES_USER=cybermind
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cybermind:replace-with-a-random-password@localhost:5432/cybermind
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-random-password
NEO4J_AUTH=neo4j/replace-with-a-random-password
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=cti_documents_v1
QDRANT_TIMEOUT=10
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_VERSION=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CHUNK_SIZE=1200
EMBEDDING_CHUNK_OVERLAP=150
GENAI_PROVIDER=disabled
GENAI_API_KEY=
GENAI_BASE_URL=https://api.openai.com/v1
GENAI_MODEL=gpt-4o-mini
GENAI_TIMEOUT=30
# Optional NVD API key for higher public API rate limits. Obtain one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
CORRELATION_PREDICTOR=trained_evidence
CORRELATION_MODEL_ARTIFACT=data/correlation/experiments/f1_improvement_v3/models/random_forest.joblib
CORRELATION_MODEL_METADATA=data/correlation/experiments/f1_improvement_v3/config.json
CORRELATION_MODEL_METRICS=data/correlation/experiments/f1_improvement_v3/metrics.json
CORRELATION_THRESHOLD=0.35
